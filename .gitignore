# Compiled class file
*.class

# Log file
*.log

# Каталог логов приложения (STORM_LOG_DIR по умолчанию — logs/)
logs/
**/logs/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/
/.gigaide/
/.idea/

# Build output
**/target/

# Environment files
*.env
.env.*
!.env.example
# .env (с секретами) не отслеживается: пример — .env.example

# Local secrets and connection settings, imported via spring.config.import
secrets.properties
/secrets.properties
!secrets.properties.example
