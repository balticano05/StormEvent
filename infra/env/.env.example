# Шаблон: скопируй в infra/env/.env и заполни. Сам .env в git не попадает.
# Те же значения нужны в secrets.properties в корне репозитория — из него
# приложение читает пароль (см. storm.event/src/main/resources/application.properties).

POSTGRES_DB=storm
POSTGRES_USER=storm
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Значения для модуля (secrets.properties) - для справки, само приложение
# берёт их из окружения запуска или secrets.properties:
#   DB_URL=jdbc:postgresql://localhost:5432/storm
#   DB_USER=storm
#   DB_PASSWORD=<тот же пароль>