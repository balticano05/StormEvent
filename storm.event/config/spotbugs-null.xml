<?xml version="1.0" encoding="UTF-8"?>
<!--
  Null-safety rule for StormEvent.

  This filter REPLACES the SpotBugs default detector set, so only the
  null-related detectors below run. Everything else SpotBugs can say
  (style, performance, deprecation, locking) is intentionally out of scope.

  Hard rule: no code path may dereference a reference that can be null.
  Anything genuinely optional is carried as java.util.Optional until the
  null is either rejected or replaced by a default.
-->
<FindBugsFilter>

    <!-- Dereference of a value that is null on at least one control-flow path. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_EXCEPTION"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE_UNKNOWN"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_PARAM_DEREF"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_PARAM_DEREF_NONVIRTUAL"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_PARAM_DEREF_ALL_SUPER_MASK"/>
    </Match>

    <!-- Values that are always / never null, or where a default silently masks a null. -->
    <Match>
        <Bug pattern="NP_ALWAYS_NULL"/>
    </Match>
    <Match>
        <Bug pattern="NP_OPTIONAL_RETURN_NULL"/>
    </Match>
    <Match>
        <Bug pattern="NP_STORE_INTO_NONNULL_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="NP_STORE_NONNULL_FIELD_VIA_NULLREF"/>
    </Match>

    <!-- Redundant null checks - signal that a nullability contract was guessed wrong. -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_COMPARISON_TWO_NULL_VALUES"/>
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_COMPARISON_OF_NULL_AND_NONNULL_VALUE"/>
    </Match>

    <!-- Fields that are never written, or always null: reading them dereferences null. -->
    <Match>
        <Bug pattern="NP_UNWRITTEN_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="NP_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="UWF_NULL_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!--
      IMPORTANT: SpotBugs does NOT read org.jetbrains.annotations.
      @Nullable from JetBrains is invisible here, so a method parameter marked
      @Nullable is not tracked as a possible null. Use
      edu.umd.cs.findbugs.annotations.Nullable (spotbugs-annotations dependency)
      when a nullability contract must be enforced by this rule.
    -->

</FindBugsFilter>
