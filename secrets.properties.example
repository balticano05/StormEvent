# Шаблон локальных секретов. Скопируй в secrets.properties и заполни.
# Сам secrets.properties не отслеживается git и не попадает в собранный jar.
# Файл читается через spring.config.import из application.properties.
# В CI и контейнерах эти же значения передаются переменными окружения.

DB_URL=jdbc:postgresql://localhost:5432/storm
DB_USER=
DB_PASSWORD=